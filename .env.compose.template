# Las variables compartidas de base de datos se reciben del .env del proyecto padre al ejecutar Docker Compose.

# Usuario habilitado para pruebas.
USER_TEST_DEVICE=99999
# Habilita el acceso directo del dispositivo de pruebas de google en aplicaciones de mobiles.
USER_TEST_ACCESS=false

# Secreto para crear y verificar el JWT BCB
BCB_JWT_PRIVATE_KEY=''
BCB_JWT_PUBLIC_KEY=''

# Habilitar solamente en una red institucional HTTP
WEB_AUTH_ALLOW_INSECURE_HTTP=false
# Origen público compartido por Keycloak y el Hub, sin puerto ni ruta.
# Auth-Service deriva el issuer, callback y retorno de logout desde este valor.
AUTH_PUBLIC_ORIGIN=http://localhost
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
# Cliente confidencial exclusivo para validar en Keycloak las credenciales que
# PVT-BE envía durante la importación de documentos. Debe tener habilitado
# Direct Access Grants y no necesita roles ni permisos de aplicación.
PVT_IMPORT_CLIENT_ID=pvt-document-import
PVT_IMPORT_CLIENT_SECRET=
# Secreto compartido para la comunicación OIDC. Se obtiene de la configuración de hub-interface en Keycloak. Se recomienda generar un secreto nuevo para cada despliegue.
OIDC_HUB_CLIENT_SECRET=22peJs0mnoQ0Kfdsafdaye39oJX34efNv9Tw
# Las claves de este catálogo deben coincidir con AUTH_TOOL_KEY en cada frontend.
# Los valores son identificadores técnicos y no contienen secretos. Los clientId se obtienen de la configuración de cada cliente en Keycloak.
AUTH_TOOL_CLIENTS={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"},"collections":{"clientId":"collections-interface"}}
# Contraseña compartida por Auth-Service y el contenedor Redis.
WEB_REDIS_PASSWORD='your_redis_password'
# Keycloak usa la conexión DB_* del launcher y almacena sus tablas en este schema.
KC_DB_SCHEMA=keycloak

# Enlace HTTPS al manual de usuario mostrado en todas las ayudas del login de Keycloak. Se recomienda usar un documento de Google Docs de solo lectura, con acceso público.
# Si queda vacío, los enlaces de ayuda no se muestran.
KEYCLOAK_USER_MANUAL_URL=https://docs.google.com/document/d/1dAaK-fiHw6JAy9atA5j_MT1sRADVc5WmqgxgcGYvV8c/edit?usp=sharing

# Credenciales usadas solamente para crear el administrador inicial y para el validador mjs.
# Se recomienda cambiar la contraseña del administrador inicial después de la primera ejecución.
KC_BOOTSTRAP_ADMIN_USER=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
